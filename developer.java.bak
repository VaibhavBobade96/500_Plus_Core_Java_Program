//Single inheritance

class employee
{
    void salary()
    {
      System.out.println("Employee Salary....");
    }
}

class developer extends employee
{
   
   void working()
   {
     System.out.println("developer Working....");
   }

}

public class SingleInheritance{

 public static void main(String[] args){

  
   developer e = new developer();

   e.salary();
   e.working();

 }

}
